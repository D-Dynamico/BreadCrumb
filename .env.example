# Breadcrumb configuration. Copy to .env and fill in. Never commit .env.
# All credentials below are fake sandbox values; there are no real accounts.

# --- Model (see D23 in docs/DECISIONS.md) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# Free key from Google AI Studio.
LLM_API_KEY=
# Cache model calls during development. Reported eval numbers are always uncached.
DEV_CACHE=true

# --- Sandbox apps the worker may use ---
MAILBOX_URL=http://localhost:8101
MAILBOX_USER=ops@acme.test
MAILBOX_PASSWORD=sandbox-mailbox-pass
VENDOR_PORTAL_URL=http://localhost:8102
VENDOR_PORTAL_USER=acme-ap
VENDOR_PORTAL_PASSWORD=sandbox-portal-pass
ADMIN_URL=http://localhost:8103
ADMIN_USER=ops.worker
ADMIN_PASSWORD=sandbox-admin-pass
ADMIN_API_TOKEN=sandbox-admin-token

# --- Gateway ---
# Commits with a money amount above this (in rupees) need requester approval (tier 2).
APPROVAL_THRESHOLD_INR=100000

# --- Budgets: hitting one ends the run as FAILED with an honest receipt ---
MAX_STEPS=60
MAX_WALL_SECONDS=900
MAX_TOKENS=400000

# --- Run store and durability ---
RUNS_DIR=runs
LEASE_TIMEOUT_SECONDS=30
HEARTBEAT_SECONDS=5
# Resume INTERRUPTED runs automatically on startup.
AUTO_RESUME=false
# Crash injection for the harness and demo. Empty means off. One of: before_intended,
# after_intended, after_dispatch, mid_batch:<k>, during_approval
CRASH_POINT=

# --- Breadcrumb UI ---
UI_PORT=8000

# --- Harness only. The agent's config never reads this. ---
ORACLE_URL=http://localhost:8109
