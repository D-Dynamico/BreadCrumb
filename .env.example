# Breadcrumb configuration. Copy to .env and fill in. Never commit .env.
# All credentials below are fake sandbox values; there are no real accounts.

# --- Model (see D23 in docs/DECISIONS.md) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# Free key from Google AI Studio.
LLM_API_KEY=
# Cache model calls during development. Reported eval numbers are always uncached.
DEV_CACHE=true
# Gemini thinking level: minimal, low, medium or high.
LLM_THINKING_LEVEL=low
# The client paces itself under this (free tier: 15 requests per minute).
LLM_REQUESTS_PER_MINUTE=15

# --- Sandbox apps the worker may use ---
MAILBOX_URL=http://localhost:8101
MAILBOX_USER=ops@acme.test
MAILBOX_PASSWORD=sandbox-mailbox-pass
VENDOR_PORTAL_URL=http://localhost:8102
VENDOR_PORTAL_USER=acme-ap
VENDOR_PORTAL_PASSWORD=sandbox-portal-pass
ADMIN_URL=http://localhost:8103
ADMIN_USER=ops.worker
ADMIN_PASSWORD=sandbox-admin-pass
ADMIN_API_TOKEN=sandbox-admin-token
# The API the worker may call (its OpenAPI spec is read from <url>/openapi.json).
API_BASE_URL=http://localhost:8103/api
# Where notify posts messages for the requester, and which channel.
NOTIFY_URL=http://localhost:8103/api/messages
NOTIFY_CHANNEL=finance-ops

# --- Gateway ---
# Commits with a money amount above this (in rupees) need requester approval (tier 2).
APPROVAL_THRESHOLD_INR=100000
# Email recipients outside this domain need requester approval (tier 2).
INTERNAL_EMAIL_DOMAIN=acme.test
# How often a waiting worker checks for an approval or an answer, in seconds.
WAIT_POLL_SECONDS=2

# --- Budgets: hitting one ends the run as FAILED with an honest receipt ---
MAX_STEPS=60
MAX_WALL_SECONDS=900
MAX_TOKENS=400000

# --- Run store and durability ---
RUNS_DIR=runs
# Run the browser without a window. `breadcrumb run --headed` shows it for one run.
HEADLESS=true
LEASE_TIMEOUT_SECONDS=30
HEARTBEAT_SECONDS=5
# Resume INTERRUPTED runs automatically on startup.
AUTO_RESUME=false
# Crash injection for the harness and demo. Empty means off. One of: before_intended,
# after_intended, after_dispatch, mid_batch:<k>, during_approval
CRASH_POINT=

# --- Breadcrumb UI ---
UI_PORT=8000

# --- Harness only. The agent's config never reads this. ---
ORACLE_URL=http://localhost:8109

# --- Sandbox only. Never given to the worker. ---
# A finance approver account, so a person can approve pending payables in Admin.
SANDBOX_APPROVER_USER=finance.approver
SANDBOX_APPROVER_PASSWORD=sandbox-approver-pass
# Signs the sandbox apps' CSRF tokens.
SANDBOX_SECRET=sandbox-only-secret
